{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar com GTK",
            "command": "gcc",
            "args": [
                "-g",
                "src/main.c",
                "src/gui.c",
                "src/home.c",
                "src/structs.c",
                "-o",
                "bin/app.exe",
                "`pkg-config --cflags --libs gtk+-3.0`"
            ],
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}